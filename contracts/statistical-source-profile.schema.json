{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contracts/statistical-source-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "reviewStatus",
    "identity",
    "measurement",
    "coverage",
    "restrictions",
    "caveats"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "ARFI-StatisticalSourceProfile"
    },
    "reviewStatus": {
      "const": "not_independently_certified"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "datasetId",
        "indicatorId",
        "sourceCommit",
        "manifestPath",
        "manifestGitBlobSha",
        "observationsSha256"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "indicatorId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^publication/releases/[a-z0-9-]+/manifest\\.json$"
        },
        "manifestGitBlobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observationsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scale",
        "unit",
        "valueField",
        "geographyField",
        "yearField",
        "statusField",
        "intervalFields",
        "exactAmountField",
        "observationUnit",
        "targetPopulation",
        "samplingDesign",
        "denominatorAvailability",
        "publisherModelled"
      ],
      "properties": {
        "family": {
          "enum": [
            "population-stock",
            "published-rate",
            "administrative-money-flow",
            "publisher-modeled-prevalence"
          ]
        },
        "scale": {
          "enum": [
            "count",
            "rate",
            "monetary-flow"
          ]
        },
        "unit": {
          "enum": [
            "persons",
            "percent",
            "USD"
          ]
        },
        "valueField": {
          "const": "value"
        },
        "geographyField": {
          "enum": [
            "fips",
            "geoid"
          ]
        },
        "yearField": {
          "const": "year"
        },
        "statusField": {
          "oneOf": [
            {
              "const": "status"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervalFields": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lower",
                "upper"
              ],
              "properties": {
                "lower": {
                  "const": "lower95"
                },
                "upper": {
                  "const": "upper95"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "exactAmountField": {
          "oneOf": [
            {
              "const": "reportedAmount"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "targetPopulation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "samplingDesign": {
          "enum": [
            "publisher-demographic-estimate",
            "published-unadjusted-labor-survey-estimate",
            "publisher-geographic-transaction-aggregate",
            "publisher-small-area-model"
          ]
        },
        "denominatorAvailability": {
          "enum": [
            "none-published",
            "publisher-derived-rate",
            "external-denominator-required"
          ]
        },
        "publisherModelled": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography",
        "geographyVintage",
        "firstYear",
        "lastYear",
        "temporalKind",
        "sourceRows",
        "availableRows",
        "explicitUnavailableRows",
        "knownOmittedSourceBuckets",
        "sourcePeriodUniform",
        "qualifierCodes",
        "allowedSegments"
      ],
      "properties": {
        "geography": {
          "enum": [
            "state",
            "county"
          ]
        },
        "geographyVintage": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2150
        },
        "firstYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2150
        },
        "lastYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2150
        },
        "temporalKind": {
          "enum": [
            "population-july-1",
            "qualified-annual-average",
            "fiscal-year-transactions",
            "modeled-reference-year"
          ]
        },
        "sourceRows": {
          "type": "integer",
          "minimum": 0
        },
        "availableRows": {
          "type": "integer",
          "minimum": 0
        },
        "explicitUnavailableRows": {
          "type": "integer",
          "minimum": 0
        },
        "knownOmittedSourceBuckets": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePeriodUniform": {
          "type": "boolean"
        },
        "qualifierCodes": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "allowedSegments": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "year",
              "stateAbbr",
              "fips"
            ]
          }
        }
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crossReleaseDerivation",
        "causalInference",
        "imputation",
        "genericShrinkage",
        "computeNewIntervals",
        "populationWeighting",
        "exactMoneyByFloat"
      ],
      "properties": {
        "crossReleaseDerivation": {
          "const": false
        },
        "causalInference": {
          "const": false
        },
        "imputation": {
          "const": false
        },
        "genericShrinkage": {
          "const": false
        },
        "computeNewIntervals": {
          "const": false
        },
        "populationWeighting": {
          "const": false
        },
        "exactMoneyByFloat": {
          "const": false
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1400
      }
    }
  }
}
