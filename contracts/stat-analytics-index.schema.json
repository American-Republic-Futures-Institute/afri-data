{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable approved analytic release registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "releases": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releaseId",
          "artifactPath",
          "artifactSha256"
        ],
        "properties": {
          "releaseId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 160
          },
          "artifactPath": {
            "type": "string",
            "pattern": "^publication/analytics/releases/[a-z0-9-]+/artifact\\.json$"
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
