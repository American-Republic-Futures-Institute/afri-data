{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI designated independent evidence reviewer policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "status",
    "approvedReviewers",
    "reviewers",
    "requirements",
    "note"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "repository": {
      "const": "American-Republic-Futures-Institute/afri-data"
    },
    "status": {
      "enum": [
        "unconfigured",
        "configured",
        "suspended"
      ]
    },
    "approvedReviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,39}$"
      }
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "login",
          "displayName",
          "status",
          "scopes",
          "validFrom",
          "expiresAt",
          "qualifications",
          "independence",
          "revocation"
        ],
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 140
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "rightsLicense",
                "methodology",
                "temporalInterpretation",
                "geographicUniverse",
                "permittedPublicUses",
                "cautions"
              ]
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "qualifications": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "evidenceUrl",
              "approvedBy",
              "approvedAt"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 24,
                "maxLength": 4000
              },
              "evidenceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "approvedBy": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,39}$"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "independence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship",
              "conflictStatus",
              "statement",
              "attestedAt"
            ],
            "properties": {
              "relationship": {
                "const": "external"
              },
              "conflictStatus": {
                "enum": [
                  "none_disclosed",
                  "disclosed_requires_recusal"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 24,
                "maxLength": 4000
              },
              "attestedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "revocation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revokedAt",
                  "reason",
                  "approvedBy"
                ],
                "properties": {
                  "revokedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 24,
                    "maxLength": 4000
                  },
                  "approvedBy": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,39}$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "minimumApprovals",
        "requireCodeOwnerReview",
        "dismissStaleReviews",
        "requireLastPushApproval",
        "enforceAdministrators",
        "requiredStatusChecks"
      ],
      "properties": {
        "branch": {
          "const": "main"
        },
        "minimumApprovals": {
          "type": "integer",
          "minimum": 1
        },
        "requireCodeOwnerReview": {
          "const": true
        },
        "dismissStaleReviews": {
          "const": true
        },
        "requireLastPushApproval": {
          "const": true
        },
        "enforceAdministrators": {
          "const": true
        },
        "requiredStatusChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    }
  }
}
