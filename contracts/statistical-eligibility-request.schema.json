{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contracts/statistical-eligibility-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "methodId",
    "sourceCommit",
    "observationsSha256",
    "intent",
    "x",
    "y",
    "segment",
    "unitOfAnalysis",
    "periodYears",
    "otherReleaseIds",
    "operations",
    "acknowledgedQualifiers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "methodId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observationsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {
      "enum": [
        "descriptive-preview",
        "public-derived-statistic",
        "statistical-inference",
        "cross-source",
        "causal"
      ]
    },
    "x": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,79}$"
    },
    "y": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unitOfAnalysis": {
      "enum": [
        "geographic-units",
        "people",
        "transactions",
        "survey-respondents"
      ]
    },
    "periodYears": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 2150
      }
    },
    "otherReleaseIds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impute",
        "sampleWeight",
        "perCapita",
        "shrinkage",
        "newInterval",
        "deriveRate",
        "excludeSourceBuckets",
        "requireUniformPeriods"
      ],
      "properties": {
        "impute": {
          "type": "boolean"
        },
        "sampleWeight": {
          "type": "boolean"
        },
        "perCapita": {
          "type": "boolean"
        },
        "shrinkage": {
          "type": "boolean"
        },
        "newInterval": {
          "type": "boolean"
        },
        "deriveRate": {
          "type": "boolean"
        },
        "excludeSourceBuckets": {
          "type": "boolean"
        },
        "requireUniformPeriods": {
          "type": "boolean"
        }
      }
    },
    "acknowledgedQualifiers": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
