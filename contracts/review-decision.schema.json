{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARFI reviewed evidence decision — does not by itself authenticate a human",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "decisionId",
    "releaseId",
    "publicationKind",
    "datasetId",
    "sourceCommit",
    "manifestSha256",
    "assetSha256",
    "originalSources",
    "authorization",
    "methodologyStatus",
    "reviewScope",
    "auditRef",
    "recordKind",
    "predecessorDecisionId",
    "reviewEvidence",
    "recordedAt"
  ],
  "properties": {
    "contract": {
      "const": "ARFI-ReviewDecision/1.0.0"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 180
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 180
    },
    "publicationKind": {
      "enum": [
        "indicator",
        "geography"
      ]
    },
    "datasetId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 180
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assetSha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "originalSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "authorization": {
      "enum": [
        "owner_authorized",
        "pending",
        "rejected",
        "superseded"
      ]
    },
    "methodologyStatus": {
      "enum": [
        "pending",
        "independent_reviewed",
        "rejected",
        "superseded"
      ]
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rightsLicense",
        "methodology",
        "temporalInterpretation",
        "geographicUniverse",
        "permittedPublicUses",
        "cautions"
      ],
      "properties": {
        "rightsLicense": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        },
        "methodology": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        },
        "temporalInterpretation": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        },
        "geographicUniverse": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        },
        "permittedPublicUses": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        },
        "cautions": {
          "enum": [
            "not_independently_certified",
            "approved",
            "approved_with_cautions",
            "rejected"
          ]
        }
      }
    },
    "auditRef": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "recordKind": {
      "enum": [
        "historical_baseline",
        "review_event"
      ]
    },
    "predecessorDecisionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 180
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewEvidence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "pullRequest",
            "headSha",
            "packetPath",
            "packetSha256",
            "reviewerLogin",
            "reviewId",
            "submittedAt"
          ],
          "properties": {
            "repository": {
              "const": "American-Republic-Futures-Institute/afri-data"
            },
            "pullRequest": {
              "type": "integer",
              "minimum": 1
            },
            "headSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "packetPath": {
              "type": "string",
              "pattern": "^governance/packets/[a-z0-9-]+[.]json$"
            },
            "packetSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reviewerLogin": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]+$",
              "maxLength": 39
            },
            "reviewId": {
              "type": "integer",
              "minimum": 1
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewFindings": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rightsLicense",
            "methodology",
            "temporalInterpretation",
            "geographicUniverse",
            "permittedPublicUses",
            "cautions",
            "conflictOfInterest"
          ],
          "properties": {
            "rightsLicense": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "methodology": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "temporalInterpretation": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "geographicUniverse": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "permittedPublicUses": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "cautions": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            },
            "conflictOfInterest": {
              "type": "string",
              "minLength": 24,
              "maxLength": 4000
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "methodologyStatus": {
            "const": "independent_reviewed"
          }
        },
        "required": [
          "methodologyStatus"
        ]
      },
      "then": {
        "required": [
          "reviewFindings"
        ],
        "properties": {
          "reviewFindings": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordKind": {
            "const": "historical_baseline"
          }
        },
        "required": [
          "recordKind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reviewFindings"
          ]
        }
      }
    }
  ]
}
